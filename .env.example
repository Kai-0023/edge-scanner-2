# Add your own value locally. Never commit a real API key.
THE_ODDS_API_KEY=
API_SPORTS_NFL_KEY=
API_SPORTS_NBA_KEY=
# Use this instead only if one API-Sports key has both subscriptions enabled.
API_SPORTS_KEY=

# Optional: powers the on-demand AI-written matchup research summary.
# Keep the real key only in .env; never place it in frontend files.
GEMINI_API_KEY=
# Leave blank to use Gemini Flash configured by the app.
GEMINI_MODEL=
